---
import UrgencyBadge from './UrgencyBadge.astro';
import CategoryIcon from './CategoryIcon.astro';
import Tag from './Tag.astro';
import SourcePill from './SourcePill.astro';
import UsesFlag from './UsesFlag.astro';
import { deriveCat, fmtDateCz } from '../lib/article';

interface Props {
  entry: any;
  dense?: boolean;
}
const { entry, dense = false } = Astro.props;
const { cat, emoji } = deriveCat(entry.data);
const iconSize = dense ? 44 : 52;
const apiVer = entry.data.api_verze?.[0];
const href = `/Shopify_news_magexo/zmena/${entry.id.replace(/\.md$/, '')}/`;

const tagy = (entry.data.tagy || []).slice(0, 3);
---
<a
  class={`article-card ${dense ? 'is-dense' : ''}`}
  href={href}
  data-kategorie={(entry.data.kategorie || []).join(',')}
  data-uses={entry.data.pouzivame_v_integratoru === 'ano' ? '1' : '0'}
  data-customer-facing={entry.data.customer_facing ? '1' : '0'}
  data-urgent={['kriticka', 'vysoka'].includes(entry.data.nalehavost) ? '1' : '0'}
  data-kanal={entry.data.zdroj_kanal}
  data-cat={cat}
>
  <CategoryIcon cat={cat} emoji={emoji} size={iconSize} />
  <div class="content">
    <div class="meta">
      <UrgencyBadge level={entry.data.nalehavost} />
      <span class="date">{fmtDateCz(entry.data.date)}</span>
      <span class="bullet">·</span>
      <SourcePill src={entry.data.zdroj_kanal} />
      {apiVer && (
        <>
          <span class="bullet">·</span>
          <span class="api-ver">API {apiVer}</span>
        </>
      )}
    </div>
    <h3 class="title">{entry.data.title}</h3>
    <p class="tldr">{entry.data.tldr}</p>
    <div class="tags">
      <Tag label={entry.data.api_oblast} kind="mono" />
      {tagy.map((t: string) => <Tag label={t} />)}
      {entry.data.pouzivame_v_integratoru !== 'ne' && (
        <UsesFlag value={entry.data.pouzivame_v_integratoru} />
      )}
    </div>
  </div>
  <div class="chevron" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18l6-6-6-6" />
    </svg>
  </div>
</a>

<style>
  .article-card {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border-1);
    cursor: pointer;
    align-items: start;
    text-decoration: none;
    color: var(--fg-1);
    transition: background 0.15s;
  }
  .article-card:hover { text-decoration: none; }
  .article-card:hover .title { color: var(--indigo-700); }
  :global([data-theme="dark"]) .article-card:hover .title { color: var(--indigo-300); }
  .article-card.is-dense { grid-template-columns: 44px 1fr auto; gap: 14px; padding: 16px 0; }

  .content { min-width: 0; }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .date { font-size: 12px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .bullet { font-size: 12px; color: var(--fg-4); }
  .api-ver { font-size: 11px; color: var(--fg-3); font-family: var(--font-mono); }

  .title {
    margin: 2px 0 6px;
    font-size: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--fg-1);
    text-wrap: balance;
    transition: color 0.15s;
  }
  .is-dense .title { font-size: 18px; }
  .tldr {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .chevron { align-self: center; color: var(--fg-4); padding-top: 4px; }
</style>
