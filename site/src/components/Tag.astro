---
interface Props {
  label: string;
  kind?: 'default' | 'outline' | 'brand' | 'mono' | 'uses' | 'src';
}
const { label, kind = 'default' } = Astro.props;
---
<span class={`tag tag-${kind}`}>{label}</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
  }
  .tag-default { background: var(--bg-3); color: var(--fg-2); }
  .tag-outline { background: transparent; color: var(--fg-3); border-color: var(--border-1); }
  .tag-brand { background: var(--indigo-50); color: var(--indigo-700); }
  .tag-mono { background: var(--bg-3); color: var(--fg-2); font-family: var(--font-mono); letter-spacing: 0; }
  .tag-uses { background: var(--cat-uses-bg); color: var(--cat-uses-fg); }
  .tag-src { background: transparent; color: var(--fg-3); border-color: var(--border-1); }
</style>
