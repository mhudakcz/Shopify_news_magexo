---
interface Props {
  value: 'ano' | 'ne' | 'mozna';
}
const { value } = Astro.props;
const map = {
  ano: { icon: '⚙️', label: 'Používáme', cls: 'uses-ano' },
  mozna: { icon: '🔧', label: 'Možná', cls: 'uses-mozna' },
  ne: null,
};
const s = map[value];
---
{s && (
  <span class={`uses-flag ${s.cls}`}>
    <span class="icon">{s.icon}</span>
    {s.label}
  </span>
)}

<style>
  .uses-flag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px 3px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-sans);
    line-height: 1.4;
  }
  .uses-flag .icon { font-size: 11px; line-height: 1; }
  .uses-ano { background: var(--cat-uses-bg); color: var(--cat-uses-fg); }
  .uses-mozna { background: var(--bg-3); color: var(--fg-2); }
</style>
