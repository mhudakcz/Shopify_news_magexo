---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Český souhrn Shopify novinek pro tým Magexo' } = Astro.props;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/Shopify_news_magexo/favicon.svg" />
    <link rel="stylesheet" href="/Shopify_news_magexo/pagefind/pagefind-ui.css" />
    <script is:inline>
      // Set theme before paint to avoid FOUC
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <header>
      <a href="/Shopify_news_magexo/" class="brand"><strong>Shopify novinky</strong> — český souhrn</a>
      <button id="theme-toggle" type="button" aria-label="Přepnout světlý/tmavý režim" title="Světlý/tmavý režim">
        <span class="icon-light">🌙</span>
        <span class="icon-dark">☀️</span>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>Generováno automaticky · <a href="https://github.com/mhudakcz/Shopify_news_magexo">zdroj</a></small>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
    <style is:global>
      :root,
      [data-theme="light"] {
        --bg: #fafafa;
        --fg: #111;
        --muted: #666;
        --border: #e0e0e0;
        --card-bg: #ffffff;
        --accent: #5b3def;
        --tag-bg: #eef;
        --tag-fg: #444;
        --warn: #d97706;
        --warn-bg: #fff7ed;
        --crit: #dc2626;
        --crit-bg: #fef2f2;
        --ok: #059669;
        --ok-bg: #ecfdf5;
        --quote-bg: #ffffff;

        --pagefind-ui-primary: var(--accent);
        --pagefind-ui-text: var(--fg);
        --pagefind-ui-background: var(--card-bg);
        --pagefind-ui-border: var(--border);
        --pagefind-ui-tag: var(--tag-bg);
        --pagefind-ui-border-radius: 6px;
      }
      [data-theme="dark"] {
        --bg: #0d0e12;
        --fg: #e8e9eb;
        --muted: #9ca3af;
        --border: #2a2d35;
        --card-bg: #161821;
        --accent: #9b85ff;
        --tag-bg: #1f222b;
        --tag-fg: #c1c4cc;
        --warn: #fbbf24;
        --warn-bg: #2a1d0f;
        --crit: #f87171;
        --crit-bg: #2a1414;
        --ok: #34d399;
        --ok-bg: #0d2218;
        --quote-bg: #161821;
      }
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        max-width: 920px;
        margin: 0 auto;
        padding: 2rem 1rem;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
        transition: background 0.15s, color 0.15s;
      }
      header {
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      header .brand { color: var(--fg); text-decoration: none; font-size: 0.95rem; }
      footer { margin-top: 4rem; color: var(--muted); }
      a { color: var(--accent); }
      h1 { font-size: 1.9rem; margin-top: 0; }
      h2 { font-size: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; margin-top: 2rem; }
      h3 { font-size: 1.05rem; margin-top: 1.5rem; }
      p.subtitle { color: var(--muted); margin-top: -0.5rem; }

      /* Theme toggle button */
      #theme-toggle {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 999px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: border-color 0.15s, background 0.15s;
      }
      #theme-toggle:hover { border-color: var(--accent); }
      #theme-toggle .icon-dark { display: none; }
      [data-theme="dark"] #theme-toggle .icon-light { display: none; }
      [data-theme="dark"] #theme-toggle .icon-dark { display: inline; }

      /* Stats panel */
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 0.5rem;
        margin: 1.5rem 0;
        padding: 1rem;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      .stats > div { text-align: center; padding: 0.3rem; }
      .stats strong { display: block; font-size: 1.6rem; line-height: 1.2; }
      .stats span { font-size: 0.78rem; color: var(--muted); }
      .stats .warn strong { color: var(--crit); }
      .stats .ok strong { color: var(--ok); }

      /* Filter chips */
      .filter-bar { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 1.5rem; }
      .filter-chip {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        font-size: 0.85rem;
        cursor: pointer;
        color: var(--fg);
        transition: border-color 0.15s, background 0.15s;
      }
      .filter-chip:hover { border-color: var(--accent); }
      .filter-chip.active {
        background: var(--accent);
        color: white;
        border-color: var(--accent);
      }

      /* Item list */
      .item-list { list-style: none; padding: 0; }
      .item-list li {
        margin-bottom: 1rem;
        padding: 1rem;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        transition: border-color 0.15s, background 0.15s;
      }
      .item-list li:hover { border-color: var(--accent); }
      .item-list a {
        text-decoration: none;
        color: var(--fg);
        display: grid;
        grid-template-columns: 56px 1fr;
        gap: 1rem;
        align-items: start;
      }
      .item-list a:hover strong { color: var(--accent); }
      .item-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        line-height: 1;
        flex-shrink: 0;
      }
      .item-icon.icon-crit { background: var(--crit-bg); }
      .item-icon.icon-warn { background: var(--warn-bg); }
      .item-icon.icon-ok { background: var(--ok-bg); }
      .item-icon.icon-neutral { background: var(--tag-bg); }
      .item-icon.icon-blog { background: var(--card-bg); padding: 0; overflow: hidden; }
      .item-icon img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; }
      .item-content { min-width: 0; }

      /* Detail page hero image */
      .article-hero {
        margin: 1rem 0 1.5rem;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border);
      }
      .article-hero img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 360px;
        object-fit: cover;
      }
      .item-head { display: flex; gap: 0.6rem; align-items: baseline; flex-wrap: wrap; }
      .item-head strong { font-size: 1.05rem; }
      .tldr { color: var(--muted); margin: 0.4rem 0; font-size: 0.95rem; line-height: 1.5; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem; }

      /* Pagination */
      .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin: 3rem 0 1rem;
        padding: 1rem;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      .page-link {
        text-decoration: none;
        padding: 0.4rem 0.9rem;
        border-radius: 6px;
        color: var(--accent);
        background: transparent;
        border: 1px solid var(--border);
        font-size: 0.9rem;
        transition: border-color 0.15s, background 0.15s;
      }
      .page-link:hover:not(.disabled) { border-color: var(--accent); background: var(--tag-bg); }
      .page-link.disabled { color: var(--muted); border-color: var(--border); cursor: default; opacity: 0.5; }
      .page-info { color: var(--muted); font-size: 0.9rem; }

      .filter-note {
        margin-top: -1rem;
        margin-bottom: 1rem;
        color: var(--muted);
      }

      /* Tags */
      .tag {
        display: inline-block;
        background: var(--tag-bg);
        color: var(--tag-fg);
        padding: 0.1rem 0.5rem;
        border-radius: 3px;
        font-size: 0.75rem;
        font-weight: 500;
      }
      .tag-breaking-change { background: var(--crit-bg); color: var(--crit); }
      .tag-deprecation { background: var(--warn-bg); color: var(--warn); }
      .tag-nova-prilezitost, .tag-nova-api { background: var(--ok-bg); color: var(--ok); }
      .tag-uses { background: var(--ok-bg); color: var(--ok); }
      .tag-warn { background: var(--warn-bg); color: var(--warn); }
      .tag-api { font-style: italic; }

      /* Urgency */
      .urgency {
        font-size: 0.7rem;
        padding: 0.1rem 0.5rem;
        border-radius: 3px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.03em;
      }
      .urgency-kriticka { background: var(--crit); color: white; }
      .urgency-vysoka { background: var(--warn); color: white; }
      .urgency-stredni { background: var(--tag-bg); color: var(--tag-fg); }
      .urgency-nizka { background: transparent; color: var(--muted); border: 1px solid var(--border); }

      /* Detail page */
      .date { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
      .meta { margin: 0.3rem 0; color: var(--muted); font-size: 0.9rem; }
      .title-en { color: var(--muted); font-style: italic; margin-top: -0.7rem; font-size: 0.95rem; }
      .badges { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 1rem 0; }
      blockquote.tldr {
        border-left: 3px solid var(--accent);
        padding: 0.5rem 1rem;
        margin: 1.2rem 0;
        background: var(--quote-bg);
        font-size: 1rem;
        color: var(--fg);
      }
      .source-footer {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.9rem;
        color: var(--muted);
      }
      .source-footer a { color: var(--muted); text-decoration: underline; text-decoration-color: var(--border); }
      .source-footer a:hover { color: var(--accent); text-decoration-color: var(--accent); }
      .source-footer-channel { color: var(--muted); font-size: 0.85rem; }
      .timeline-box {
        background: var(--warn-bg);
        border-left: 3px solid var(--warn);
        padding: 0.8rem 1rem;
        margin: 1.2rem 0;
        border-radius: 0 4px 4px 0;
      }
      .timeline-box h3 { margin-top: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--warn); }
      .timeline-box ul { margin: 0; padding-left: 1.2rem; }
      .related, .affected { margin-top: 2rem; }
      details { margin-top: 1.5rem; color: var(--muted); }
      summary { cursor: pointer; }

      /* Tables in markdown body */
      table { border-collapse: collapse; margin: 1rem 0; width: 100%; }
      th, td { border: 1px solid var(--border); padding: 0.4rem 0.7rem; text-align: left; }
      th { background: var(--card-bg); }

      code {
        background: var(--tag-bg);
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
        font-size: 0.9em;
      }
      pre {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 0.8rem;
        border-radius: 6px;
        overflow-x: auto;
      }
      pre code { background: transparent; padding: 0; }
    </style>
  </body>
</html>
