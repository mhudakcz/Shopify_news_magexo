---
import '../styles/tokens.css';
import '../styles/base.css';
import BrandMark from '../components/BrandMark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  variant?: 'listing' | 'detail';
  totalCount?: number;
  noHeader?: boolean;
}
const {
  title,
  description = 'Český souhrn Shopify novinek pro tým Magexo',
  variant = 'listing',
  totalCount,
  noHeader = false,
} = Astro.props;
const isDetail = variant === 'detail';
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/Shopify_news_magexo/favicon.svg" />
    <link rel="stylesheet" href="/Shopify_news_magexo/pagefind/pagefind-ui.css" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    {!noHeader && (
      <header class={`site-header ${isDetail ? 'is-detail' : ''}`}>
        <BrandMark small={isDetail} />
        <nav>
          <a href="/Shopify_news_magexo/" class="nav-link">Přehled</a>
          <a href="/Shopify_news_magexo/" class="nav-link">Archiv</a>
          {totalCount != null && (
            <>
              <span class="divider" aria-hidden="true"></span>
              <span class="count">{totalCount} článků</span>
            </>
          )}
          <ThemeToggle small />
        </nav>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!noHeader && (
      <footer class="site-footer">
        <span>Interní agregátor Magexo · zdroje: shopify.dev, changelog.shopify.com, shopify.com/editions, shopify.com/blog</span>
        <span>
          <a href="https://github.com/mhudakcz/Shopify_news_magexo" target="_blank" rel="noopener">repo</a>
        </span>
      </footer>
    )}

    <style is:global>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 48px;
        border-bottom: 1px solid var(--border-1);
        background: var(--bg-elev);
      }
      .site-header.is-detail { padding: 14px 32px; }
      .site-header nav {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-sans);
        font-size: 13px;
      }
      .site-header .nav-link {
        color: var(--fg-2);
        padding: 6px 10px;
        text-decoration: none;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
      }
      .site-header .nav-link:hover {
        background: var(--bg-3);
        color: var(--fg-1);
        text-decoration: none;
      }
      .site-header .divider {
        width: 1px;
        height: 18px;
        background: var(--border-1);
        margin: 0 8px;
      }
      .site-header .count {
        color: var(--fg-3);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
      }
      .site-footer {
        border-top: 1px solid var(--border-1);
        padding: 24px 48px;
        color: var(--fg-3);
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .site-footer a { color: var(--fg-3); }
      .site-footer a:hover { color: var(--indigo-600); }

      @media (max-width: 720px) {
        .site-header { padding: 14px 16px; }
        .site-header nav .nav-link { display: none; }
        .site-header nav .count { display: none; }
        .site-header nav .divider { display: none; }
        .site-footer { padding: 20px 16px; flex-direction: column; }
      }
    </style>
  </body>
</html>
