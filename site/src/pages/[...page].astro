---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Stat from '../components/Stat.astro';
import SearchInput from '../components/SearchInput.astro';
import { isoWeekKey, weekRange } from '../lib/article';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const all = await getCollection('summaries');
  const sorted = all.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  const now = new Date();
  const startOfWeek = new Date(now);
  startOfWeek.setDate(now.getDate() - ((now.getDay() + 6) % 7));
  startOfWeek.setHours(0, 0, 0, 0);
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

  const stats = {
    thisWeek: sorted.filter((i) => new Date(i.data.date) >= startOfWeek).length,
    thisMonth: sorted.filter((i) => new Date(i.data.date) >= startOfMonth).length,
    total: sorted.length,
    breaking: sorted.filter((i) => i.data.kategorie.includes('breaking-change')).length,
    uses: sorted.filter((i) => i.data.pouzivame_v_integratoru === 'ano').length,
  };

  const counts = {
    all: sorted.length,
    'breaking-change': sorted.filter((i) => i.data.kategorie.includes('breaking-change')).length,
    'nova-prilezitost': sorted.filter((i) => i.data.kategorie.some((k: string) => k === 'nova-prilezitost' || k === 'nova-api')).length,
    deprecation: sorted.filter((i) => i.data.kategorie.includes('deprecation')).length,
    uses: sorted.filter((i) => i.data.pouzivame_v_integratoru === 'ano').length,
    customer: sorted.filter((i) => i.data.customer_facing).length,
    urgent: sorted.filter((i) => ['kriticka', 'vysoka'].includes(i.data.nalehavost)).length,
    dev: sorted.filter((i) => i.data.zdroj_kanal === 'dev-changelog').length,
    merchant: sorted.filter((i) => i.data.zdroj_kanal === 'merchant-changelog').length,
    editions: sorted.filter((i) => i.data.zdroj_kanal === 'editions').length,
    blog: sorted.filter((i) => i.data.zdroj_kanal === 'blog').length,
    news: sorted.filter((i) => i.data.zdroj_kanal === 'product-news').length,
  };

  // Editions hub: nejnovější článek s kategorie obsahující 'editions-hub'
  // Zobrazí se jako pinned hero banner na první stránce
  const editionsHub = sorted.find((i: any) => (i.data.kategorie || []).includes('editions-hub')) || null;

  const pages = paginate(sorted, { pageSize: 30 });
  return pages.map((p: any) => ({
    params: p.params,
    props: { ...p.props, stats, counts, editionsHub },
  }));
}

const { page, stats, counts, editionsHub } = Astro.props;

// Hub se zobrazuje jako pinned banner — vyjmeme ho z běžného grid na stránce 1
const hubId = editionsHub ? editionsHub.id : null;
const pageItems = page.currentPage === 1 && hubId
  ? page.data.filter((i: any) => i.id !== hubId)
  : page.data;

const grouped = new Map<string, typeof page.data>();
for (const item of pageItems) {
  const key = isoWeekKey(new Date(item.data.date));
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(item);
}

const editionsHubSlug = editionsHub ? editionsHub.id.replace(/\.md$/, '') : null;
const editionsRelease = editionsHub?.data?.editions_release || null;
const editionsHubDate = editionsHub ? new Date(editionsHub.data.date) : null;
---
<Layout
  title={`Shopify novinky${page.currentPage > 1 ? ` — strana ${page.currentPage}` : ''}`}
  variant="listing"
  noHeader={true}
>
  <div class="app-grid">
    <Sidebar counts={counts} variant="listing" />

    <main class="main-col">
      <div class="topbar">
        <div class="topbar-search">
          <SearchInput placeholder={'Hledat — např. „checkout extension" nebo „2026-07"…'} />
        </div>
      </div>

      <section class="hero-compact">
        <h1>
          <span class="grad-text">Shopify novinky</span><span class="hero-comma">, česky.</span>
        </h1>
        <p class="lead">
          Souhrn ze 4 zdrojů — Dev Changelog, Merchant Changelog, Editions a Shopify blog. Filtrované, kategorizované a označené podle dopadu na <strong>Integrátor</strong>.
        </p>

        {page.currentPage === 1 && (
          <div class="stats-row">
            <Stat value={stats.thisWeek} label="Tento týden" accent />
            <Stat value={stats.thisMonth} label="Tento měsíc" />
            <Stat value={stats.total} label="Celkem" />
            <Stat value={stats.breaking} label="Breaking" warn />
            <Stat value={stats.uses} label="Používáme" />
          </div>
        )}
      </section>

      {page.currentPage === 1 && editionsHub && (
        <section class="editions-pinned" aria-label="Aktivní Shopify Editions">
          <a href={`/Shopify_news_magexo/zmena/${editionsHubSlug}/`} class="editions-banner">
            <div class="ep-spark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
              </svg>
            </div>
            <div class="ep-body">
              <div class="ep-eyebrow">
                <span class="ep-pulse"></span>
                NOVÁ EDITIONS · {editionsHubDate?.toLocaleDateString('cs-CZ')}
              </div>
              <div class="ep-title">{editionsHub.data.title}</div>
              <div class="ep-tldr">{editionsHub.data.tldr}</div>
            </div>
            <div class="ep-cta">
              Otevřít hub
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        </section>
      )}

      <section class="cards-grid-section">
        {page.data.length === 0 ? (
          <p class="empty"><em>Zatím žádné souhrny.</em></p>
        ) : (
          [...grouped.entries()].map(([wk, items]) => {
            const firstDate = new Date(items[0].data.date);
            return (
              <div class="week-block" data-week={wk}>
                <div class="week-header">
                  <span class="week-tag">{wk}</span>
                  <span class="week-range">{weekRange(firstDate)}</span>
                  <span class="week-count">{items.length} novinek</span>
                </div>
                <div class="card-grid">
                  {items.map((item: any) => <ArticleCard entry={item} />)}
                </div>
              </div>
            );
          })
        )}

        <nav class="pagination" aria-label="Stránkování">
          {page.url.prev ? (
            <a class="page-link" href={page.url.prev}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
              Novější
            </a>
          ) : (
            <span class="page-link disabled">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
              Novější
            </span>
          )}
          <span class="page-info">
            Strana <strong>{page.currentPage}</strong> z <span class="muted">{page.lastPage}</span>
          </span>
          {page.url.next ? (
            <a class="page-link primary" href={page.url.next}>
              Starší novinky
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          ) : (
            <span class="page-link disabled">
              Starší novinky
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </span>
          )}
        </nav>
      </section>
    </main>
  </div>

  <script>
    const navItems = document.querySelectorAll<HTMLButtonElement>('.nav-item');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.card');
    const weeks = document.querySelectorAll<HTMLElement>('.week-block');

    // Apply filter from URL param ?filter=X on load (so detail-page nav links work)
    const urlFilter = new URLSearchParams(window.location.search).get('filter');
    if (urlFilter) {
      const target = Array.from(navItems).find((n) => n.dataset.filter === urlFilter);
      if (target) {
        setTimeout(() => target.click(), 0);
      }
    }

    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navItems.forEach((c) => c.classList.remove('active'));
        item.classList.add('active');
        const filter = item.dataset.filter || 'all';

        cards.forEach((card) => {
          let show = filter === 'all';
          if (filter === 'uses') show = card.dataset.uses === '1';
          else if (filter === 'customer-facing') show = card.dataset.customerFacing === '1';
          else if (filter === 'urgent') show = card.dataset.urgent === '1';
          else if (filter === 'nova-prilezitost') {
            const k = card.dataset.kategorie || '';
            show = k.includes('nova-prilezitost') || k.includes('nova-api');
          }
          else if (filter.startsWith('kanal:')) show = card.dataset.kanal === filter.split(':')[1];
          else if (filter !== 'all') show = (card.dataset.kategorie || '').split(',').includes(filter);
          (card as HTMLElement).style.display = show ? '' : 'none';
        });

        weeks.forEach((w) => {
          const visible = [...w.querySelectorAll('.card')].some(
            (c) => (c as HTMLElement).style.display !== 'none'
          );
          w.style.display = visible ? '' : 'none';
        });
      });
    });
  </script>
</Layout>

<style>
  .app-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
  }

  .main-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Topbar */
  .topbar {
    padding: 16px 32px;
    border-bottom: 1px solid var(--border-1);
    background: var(--bg-elev);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .topbar-search { max-width: 540px; }

  /* Hero compact */
  .hero-compact {
    padding: 32px 32px 24px;
    border-bottom: 1px solid var(--border-1);
  }
  .hero-compact h1 {
    margin: 0;
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  .hero-comma { color: var(--fg-1); }
  .lead {
    margin: 16px 0 24px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-2);
    max-width: 760px;
    text-wrap: pretty;
  }
  .stats-row {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
  }

  /* Editions pinned hero banner */
  .editions-pinned {
    padding: 24px 32px 0;
  }
  .editions-banner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 22px 26px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
    color: #fff;
    border-radius: 14px;
    text-decoration: none;
    box-shadow: 0 8px 28px -8px rgba(79, 70, 229, 0.55);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }
  .editions-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 90% 50%, rgba(255,255,255,0.15) 0%, transparent 60%);
    pointer-events: none;
  }
  .editions-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px -8px rgba(79, 70, 229, 0.7);
    text-decoration: none;
  }
  .ep-spark {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    color: #fff;
  }
  .ep-body { min-width: 0; }
  .ep-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
  }
  .ep-pulse {
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    animation: ep-pulse 2s ease-out infinite;
  }
  @keyframes ep-pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
    70% { box-shadow: 0 0 0 12px rgba(255, 255, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
  }
  .ep-title {
    font-size: 19px;
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 6px;
    color: #fff;
  }
  .ep-tldr {
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ep-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    backdrop-filter: blur(8px);
    transition: background 0.15s;
  }
  .editions-banner:hover .ep-cta {
    background: rgba(255, 255, 255, 0.3);
  }
  @media (max-width: 720px) {
    .editions-banner { grid-template-columns: 1fr; padding: 18px 20px; }
    .ep-cta { justify-self: end; }
  }

  /* Cards grid section */
  .cards-grid-section { padding: 24px 32px 56px; }
  .week-block { margin-bottom: 36px; }
  .week-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px 0 14px;
    margin-bottom: 14px;
    border-bottom: 2px solid var(--fg-1);
  }
  .week-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 800;
    padding: 2px 8px;
    background: var(--indigo-50);
    color: var(--indigo-700);
    border-radius: 4px;
    letter-spacing: -0.01em;
  }
  :global([data-theme="dark"]) .week-tag {
    background: rgba(79, 70, 229, 0.18);
    color: var(--indigo-300);
  }
  .week-range { font-size: 14px; font-weight: 600; color: var(--fg-1); }
  .week-count { font-size: 12px; color: var(--fg-3); margin-left: auto; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .empty { color: var(--fg-3); font-size: 14px; padding: 40px 0; text-align: center; }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border-1);
    gap: 12px;
  }
  .page-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--border-1);
    background: var(--bg-elev);
    color: var(--fg-2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    transition: all 0.15s;
  }
  .page-link:hover { border-color: var(--border-2); background: var(--bg-3); text-decoration: none; }
  .page-link.disabled { opacity: 0.5; pointer-events: none; }
  .page-link.primary {
    border-color: var(--indigo-600);
    background: var(--indigo-600);
    color: #fff;
    box-shadow: var(--shadow-glow);
  }
  .page-info { font-size: 13px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .page-info strong { color: var(--fg-1); font-weight: 600; }
  .page-info .muted { color: var(--fg-2); }

  /* Responsive */
  @media (max-width: 900px) {
    .app-grid { grid-template-columns: 1fr; }
    .topbar { padding: 14px 16px; }
    .hero-compact { padding: 20px 16px; }
    .hero-compact h1 { font-size: 32px; }
    .stats-row { gap: 20px; }
    .cards-grid-section { padding: 16px 16px 32px; }
  }
</style>
