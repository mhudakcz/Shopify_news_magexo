---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Stat from '../components/Stat.astro';
import SearchInput from '../components/SearchInput.astro';
import FilterChip from '../components/FilterChip.astro';
import { isoWeekKey, weekRange } from '../lib/article';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const all = await getCollection('summaries');
  const sorted = all.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  const now = new Date();
  const startOfWeek = new Date(now);
  startOfWeek.setDate(now.getDate() - ((now.getDay() + 6) % 7));
  startOfWeek.setHours(0, 0, 0, 0);
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

  const stats = {
    thisWeek: sorted.filter((i) => new Date(i.data.date) >= startOfWeek).length,
    thisMonth: sorted.filter((i) => new Date(i.data.date) >= startOfMonth).length,
    total: sorted.length,
    breaking: sorted.filter((i) => i.data.kategorie.includes('breaking-change')).length,
    uses: sorted.filter((i) => i.data.pouzivame_v_integratoru === 'ano').length,
  };

  // Per-filter counts (computed globally, just informational on chips)
  const counts = {
    all: sorted.length,
    'breaking-change': sorted.filter((i) => i.data.kategorie.includes('breaking-change')).length,
    'nova-prilezitost': sorted.filter((i) => i.data.kategorie.some((k: string) => k === 'nova-prilezitost' || k === 'nova-api')).length,
    deprecation: sorted.filter((i) => i.data.kategorie.includes('deprecation')).length,
    uses: sorted.filter((i) => i.data.pouzivame_v_integratoru === 'ano').length,
    customer: sorted.filter((i) => i.data.customer_facing).length,
    urgent: sorted.filter((i) => ['kriticka', 'vysoka'].includes(i.data.nalehavost)).length,
    dev: sorted.filter((i) => i.data.zdroj_kanal === 'dev-changelog').length,
    merchant: sorted.filter((i) => i.data.zdroj_kanal === 'merchant-changelog').length,
    editions: sorted.filter((i) => i.data.zdroj_kanal === 'editions').length,
    blog: sorted.filter((i) => i.data.zdroj_kanal === 'blog').length,
  };

  const pages = paginate(sorted, { pageSize: 30 });
  return pages.map((p: any) => ({
    params: p.params,
    props: { ...p.props, stats, counts },
  }));
}

const { page, stats, counts } = Astro.props;

// Group page items by ISO week
const grouped = new Map<string, typeof page.data>();
for (const item of page.data) {
  const key = isoWeekKey(new Date(item.data.date));
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(item);
}
---
<Layout
  title={`Shopify novinky${page.currentPage > 1 ? ` — strana ${page.currentPage}` : ''}`}
  variant="listing"
  totalCount={counts.all}
>
  <section class="hero">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-chip">
        <span class="hero-chip-dot"></span>
        Aktualizováno 2× týdně · út a čt
      </div>
      <h1>
        <span class="grad-text">Shopify novinky</span><span class="hero-comma">, česky.</span>
      </h1>
      <p class="lead">
        Souhrn ze 4 zdrojů — <strong>Dev Changelog</strong>, <strong>Merchant Changelog</strong>,
        <strong>Editions</strong> a <strong>Shopify blog</strong>. Filtrované, kategorizované
        a označené podle dopadu na <strong>Integrátor</strong>.
      </p>

      {page.currentPage === 1 && (
        <div class="stats">
          <Stat value={stats.thisWeek} label="Tento týden" big accent />
          <Stat value={stats.thisMonth} label="Tento měsíc" big />
          <Stat value={stats.total} label="Celkem" big />
          <Stat value={stats.breaking} label="Breaking" big warn />
          <Stat value={stats.uses} label="Používáme" big />
        </div>
      )}
    </div>
  </section>

  <section class="filters">
    <div class="filters-inner">
      <SearchInput placeholder={'Hledat — např. „checkout extension" nebo „2026-07"…'} large />
      <div class="chip-row">
        <FilterChip label="Vše" count={counts.all} filter="all" active />
        <FilterChip label="Breaking" icon="🔥" count={counts['breaking-change']} filter="breaking-change" />
        <FilterChip label="Příležitost" icon="✨" count={counts['nova-prilezitost']} filter="nova-prilezitost" />
        <FilterChip label="Deprecation" icon="⏰" count={counts.deprecation} filter="deprecation" />
        <FilterChip label="Používáme" icon="⚙️" count={counts.uses} filter="uses" />
        <FilterChip label="Customer-facing" icon="👤" count={counts.customer} filter="customer-facing" />
        <FilterChip label="Urgentní" icon="🚨" count={counts.urgent} filter="urgent" />
        <span class="chip-divider" aria-hidden="true"></span>
        <FilterChip label="Dev" icon="🆕" count={counts.dev} filter="kanal:dev-changelog" />
        <FilterChip label="Merchant" icon="🛍️" count={counts.merchant} filter="kanal:merchant-changelog" />
        <FilterChip label="Editions" icon="🎉" count={counts.editions} filter="kanal:editions" />
        <FilterChip label="Blog" icon="📝" count={counts.blog} filter="kanal:blog" />
      </div>
    </div>
  </section>

  <section class="cards-section">
    <div class="cards-inner">
      {page.data.length === 0 ? (
        <p class="empty"><em>Zatím žádné souhrny.</em></p>
      ) : (
        [...grouped.entries()].map(([wk, items]) => {
          const firstDate = new Date(items[0].data.date);
          return (
            <div class="week" data-week={wk}>
              <div class="week-header">
                <h2>{wk}</h2>
                <span class="week-range">{weekRange(firstDate)}</span>
                <span class="week-count">· {items.length} novinek</span>
              </div>
              {items.map((item: any) => <ArticleCard entry={item} />)}
            </div>
          );
        })
      )}

      <nav class="pagination" aria-label="Stránkování">
        {page.url.prev ? (
          <a class="page-link" href={page.url.prev}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            Novější
          </a>
        ) : (
          <span class="page-link disabled">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            Novější
          </span>
        )}
        <span class="page-info">
          Strana <strong>{page.currentPage}</strong> z <span class="muted">{page.lastPage}</span>
        </span>
        {page.url.next ? (
          <a class="page-link primary" href={page.url.next}>
            Starší novinky
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        ) : (
          <span class="page-link disabled">
            Starší novinky
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </span>
        )}
      </nav>
    </div>
  </section>

  <script>
    // Filter chip toggle — single-active, applies via data-attribute filtering on .article-card
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.article-card');
    const weeks = document.querySelectorAll<HTMLElement>('.week');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('chip-active'));
        chip.classList.add('chip-active');
        const filter = chip.dataset.filter || 'all';

        cards.forEach((card) => {
          let show = filter === 'all';
          if (filter === 'uses') show = card.dataset.uses === '1';
          else if (filter === 'customer-facing') show = card.dataset.customerFacing === '1';
          else if (filter === 'urgent') show = card.dataset.urgent === '1';
          else if (filter === 'nova-prilezitost') {
            const k = card.dataset.kategorie || '';
            show = k.includes('nova-prilezitost') || k.includes('nova-api');
          }
          else if (filter.startsWith('kanal:')) show = card.dataset.kanal === filter.split(':')[1];
          else if (filter !== 'all') show = (card.dataset.kategorie || '').split(',').includes(filter);
          (card as HTMLElement).style.display = show ? '' : 'none';
        });

        weeks.forEach((w) => {
          const visible = [...w.querySelectorAll('.article-card')].some(
            (c) => (c as HTMLElement).style.display !== 'none'
          );
          w.style.display = visible ? '' : 'none';
        });
      });
    });
  </script>
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 64px 48px 32px;
    border-bottom: 1px solid var(--border-1);
    position: relative;
    overflow: hidden;
  }
  .hero-orb {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 460px;
    height: 460px;
    background: radial-gradient(closest-side, rgba(79, 70, 229, 0.16), rgba(124, 58, 237, 0.06) 40%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner { max-width: 1180px; position: relative; margin: 0 auto; }
  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 8px;
    border-radius: 999px;
    background: var(--indigo-50);
    color: var(--indigo-700);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 22px;
  }
  [data-theme="dark"] .hero-chip { background: rgba(79, 70, 229, 0.16); color: var(--indigo-300); }
  .hero-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--indigo-600);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.22);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(40px, 6.5vw, 76px);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  .hero-comma { color: var(--fg-1); }
  .lead {
    margin: 20px 0 36px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-2);
    max-width: 640px;
    text-wrap: pretty;
  }
  .lead strong { font-weight: 600; color: var(--fg-1); }
  .stats {
    display: grid;
    grid-template-columns: repeat(5, auto);
    gap: 48px;
    justify-content: start;
  }
  @media (max-width: 720px) {
    .hero { padding: 28px 16px 20px; }
    .hero h1 { font-size: 38px; line-height: 1.02; }
    .lead { font-size: 14px; margin: 12px 0 18px; }
    .stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--border-1);
      border-radius: 10px;
      overflow: hidden;
      background: var(--bg-elev);
    }
    .stats :global(.stat) { padding: 10px 12px; }
    .stats :global(.stat:not(:last-child)) { border-right: 1px solid var(--border-1); }
    .stats :global(.stat-value) { font-size: 18px !important; }
    .stats :global(.stat:nth-child(n+4)) { display: none; }
  }

  /* Filters */
  .filters {
    padding: 24px 48px 16px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border-1);
  }
  .filters-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .chip-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }
  .chip-divider {
    width: 1px;
    background: var(--border-1);
    margin: 0 4px;
    align-self: stretch;
  }
  @media (max-width: 720px) {
    .filters { padding: 14px 16px; position: static; }
    .chip-row {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -16px;
      padding: 0 16px;
    }
    .chip-row::-webkit-scrollbar { display: none; }
  }

  /* Cards section */
  .cards-section { padding: 32px 48px 64px; }
  .cards-inner { max-width: 1180px; margin: 0 auto; }
  .empty { color: var(--fg-3); font-size: 14px; padding: 40px 0; text-align: center; }

  .week { margin-bottom: 48px; }
  .week-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--fg-1);
  }
  .week-header h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: var(--tracking-snug);
    font-family: var(--font-mono);
    color: var(--fg-1);
  }
  .week-range { font-size: 13px; color: var(--fg-2); font-weight: 600; }
  .week-count { font-size: 12px; color: var(--fg-3); }
  @media (max-width: 720px) {
    .cards-section { padding: 8px 16px 32px; }
    .week-header { padding: 12px 0 8px; border-bottom-width: 2px; margin-bottom: 4px; }
    .week-header h2 { font-size: 14px; }
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-1);
    gap: 12px;
  }
  .page-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--border-1);
    background: var(--bg-elev);
    color: var(--fg-2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    transition: all 0.15s;
  }
  .page-link:hover { border-color: var(--border-2); background: var(--bg-3); text-decoration: none; }
  .page-link.disabled { opacity: 0.5; pointer-events: none; }
  .page-link.primary {
    border-color: var(--indigo-600);
    background: var(--indigo-600);
    color: #fff;
    box-shadow: var(--shadow-glow);
  }
  .page-link.primary:hover { background: var(--indigo-700); border-color: var(--indigo-700); }
  .page-info { font-size: 13px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .page-info strong { color: var(--fg-1); font-weight: 600; }
  .page-info .muted { color: var(--fg-2); }
</style>
