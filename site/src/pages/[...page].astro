---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const all = await getCollection('summaries');
  const sorted = all.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  const now = new Date();
  const startOfWeek = new Date(now);
  startOfWeek.setDate(now.getDate() - ((now.getDay() + 6) % 7));
  startOfWeek.setHours(0, 0, 0, 0);
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

  const stats = {
    thisWeek: sorted.filter((i) => new Date(i.data.date) >= startOfWeek).length,
    thisMonth: sorted.filter((i) => new Date(i.data.date) >= startOfMonth).length,
    total: sorted.length,
    breaking: sorted.filter((i) => i.data.kategorie.includes('breaking-change')).length,
    uses: sorted.filter((i) => i.data.pouzivame_v_integratoru === 'ano').length,
  };

  const pages = paginate(sorted, { pageSize: 30 });
  return pages.map((p: any) => ({
    params: p.params,
    props: { ...p.props, stats },
  }));
}

const { page, stats } = Astro.props;

function isoWeek(d: Date): string {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = t.getUTCDay() || 7;
  t.setUTCDate(t.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  const weekNo = Math.ceil(((+t - +yearStart) / 86400000 + 1) / 7);
  return `${t.getUTCFullYear()}-W${String(weekNo).padStart(2, '0')}`;
}

const grouped = new Map<string, typeof page.data>();
for (const item of page.data) {
  const key = isoWeek(new Date(item.data.date));
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(item);
}

function itemIcon(item: any): string {
  if (item.data.zdroj_kanal === 'blog') return '📝';
  if (item.data.zdroj_kanal === 'merchant-changelog') return '🛍️';
  if (item.data.nalehavost === 'kriticka') return '🚨';
  const cat = item.data.kategorie[0];
  if (cat === 'breaking-change') return '🔥';
  if (cat === 'deprecation') return '⏰';
  if (cat === 'nova-prilezitost') return '✨';
  if (cat === 'nova-api') return '🆕';
  if (cat === 'seo') return '🔍';
  if (cat === 'integrace') return '🔌';
  if (cat === 'fyi') return '📋';
  return '📰';
}

function itemIconClass(item: any): string {
  if (item.data.zdroj_kanal === 'blog' && item.data.obrazek) return 'icon-blog';
  const cat = item.data.kategorie[0];
  if (cat === 'breaking-change' || item.data.nalehavost === 'kriticka') return 'icon-crit';
  if (cat === 'deprecation') return 'icon-warn';
  if (cat === 'nova-prilezitost' || cat === 'nova-api') return 'icon-ok';
  return 'icon-neutral';
}
---
<Layout title={`Shopify novinky${page.currentPage > 1 ? ` — strana ${page.currentPage}` : ''}`}>
  <h1>Shopify novinky</h1>
  <p class="subtitle">Český souhrn z <a href="https://shopify.dev/changelog">shopify.dev/changelog</a> a <a href="https://www.shopify.com/editions/winter2026">Shopify Editions</a>. Generuje se v úterý a ve čtvrtek.</p>

  {page.currentPage === 1 && (
    <div class="stats">
      <div><strong>{stats.thisWeek}</strong><span>tento týden</span></div>
      <div><strong>{stats.thisMonth}</strong><span>tento měsíc</span></div>
      <div><strong>{stats.total}</strong><span>celkem</span></div>
      <div class="warn"><strong>{stats.breaking}</strong><span>breaking changes</span></div>
      <div class="ok"><strong>{stats.uses}</strong><span>používáme</span></div>
    </div>
  )}

  <div id="search" data-pagefind-ui></div>

  <div class="filter-bar">
    <button class="filter-chip active" data-filter="all">Vše</button>
    <button class="filter-chip" data-filter="breaking-change">🔥 Breaking</button>
    <button class="filter-chip" data-filter="nova-prilezitost">✨ Příležitost</button>
    <button class="filter-chip" data-filter="deprecation">⏰ Deprecation</button>
    <button class="filter-chip" data-filter="uses">⚙️ Používáme</button>
    <button class="filter-chip" data-filter="customer-facing">👤 Customer-facing</button>
    <button class="filter-chip" data-filter="urgent">🚨 Urgentní</button>
    <button class="filter-chip" data-filter="kanal:editions">🎉 Editions</button>
    <button class="filter-chip" data-filter="kanal:product-news">📰 Product news</button>
    <button class="filter-chip" data-filter="kanal:merchant-changelog">🛍️ Merchant</button>
    <button class="filter-chip" data-filter="kanal:blog">📝 Blog</button>
  </div>
  <p class="filter-note"><small>Filtry pracují v rámci aktuální stránky.</small></p>

  {page.data.length === 0 ? (
    <p><em>Zatím žádné souhrny. Spusť <code>/run-news</code> v Claude Code.</em></p>
  ) : (
    [...grouped.entries()].map(([week, items]) => (
      <section class="week-section">
        <h2>Týden {week} <span class="date">({items.length})</span></h2>
        <ul class="item-list">
          {items.map((item) => (
            <li
              data-kategorie={item.data.kategorie.join(',')}
              data-uses={item.data.pouzivame_v_integratoru === 'ano' ? '1' : '0'}
              data-customer-facing={item.data.customer_facing ? '1' : '0'}
              data-urgent={['kriticka', 'vysoka'].includes(item.data.nalehavost) ? '1' : '0'}
              data-kanal={item.data.zdroj_kanal}
            >
              <a href={`/Shopify_news_magexo/zmena/${item.id.replace(/\.md$/, '')}/`}>
                <span class={`item-icon ${itemIconClass(item)}`}>
                  {item.data.zdroj_kanal === 'blog' && item.data.obrazek ? (
                    <img src={item.data.obrazek} alt="" loading="lazy" />
                  ) : (
                    itemIcon(item)
                  )}
                </span>
                <div class="item-content">
                  <div class="item-head">
                    <span class={`urgency urgency-${item.data.nalehavost}`}>{item.data.nalehavost}</span>
                    <span class="date">{new Date(item.data.date).toLocaleDateString('cs-CZ')}</span>
                    <strong>{item.data.title}</strong>
                  </div>
                  <p class="tldr">{item.data.tldr}</p>
                  <div class="tags">
                    {item.data.kategorie.map((k) => <span class={`tag tag-${k}`}>{k}</span>)}
                    <span class="tag tag-api">{item.data.api_oblast}</span>
                    {item.data.pouzivame_v_integratoru === 'ano' && (
                      <span class="tag tag-uses">⚙️ používáme</span>
                    )}
                    {item.data.customer_facing && (
                      <span class="tag">👤 customer-facing</span>
                    )}
                    {item.data.zdroj_kanal === 'editions' && (
                      <span class="tag" title="Shopify Editions Winter '26">🎉 Editions</span>
                    )}
                    {item.data.zdroj_kanal === 'product-news' && (
                      <span class="tag">📰 News</span>
                    )}
                    {item.data.zdroj_kanal === 'merchant-changelog' && (
                      <span class="tag" title="changelog.shopify.com">🛍️ Merchant</span>
                    )}
                    {item.data.zdroj_kanal === 'blog' && (
                      <span class="tag">📝 Blog</span>
                    )}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}

  <nav class="pagination" aria-label="Stránkování">
    {page.url.prev ? (
      <a class="page-link" href={page.url.prev}>← novější</a>
    ) : (
      <span class="page-link disabled">← novější</span>
    )}
    <span class="page-info">
      strana <strong>{page.currentPage}</strong> z {page.lastPage}
    </span>
    {page.url.next ? (
      <a class="page-link" href={page.url.next}>starší →</a>
    ) : (
      <span class="page-link disabled">starší →</span>
    )}
  </nav>

  <script>
    import { PagefindUI } from '@pagefind/default-ui';
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: 'Hledat v novinkách…',
        zero_results: 'Pro „[SEARCH_TERM]" nic nenalezeno.',
      },
    });

    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const items = document.querySelectorAll<HTMLLIElement>('.item-list li');
    const sections = document.querySelectorAll<HTMLElement>('.week-section');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        const filter = chip.dataset.filter || 'all';

        items.forEach((li) => {
          let show = filter === 'all';
          if (filter === 'uses') show = li.dataset.uses === '1';
          else if (filter === 'customer-facing') show = li.dataset.customerFacing === '1';
          else if (filter === 'urgent') show = li.dataset.urgent === '1';
          else if (filter.startsWith('kanal:')) show = li.dataset.kanal === filter.split(':')[1];
          else if (filter !== 'all') show = (li.dataset.kategorie || '').split(',').includes(filter);
          li.style.display = show ? '' : 'none';
        });

        sections.forEach((s) => {
          const visible = [...s.querySelectorAll('li')].some(
            (li) => (li as HTMLElement).style.display !== 'none'
          );
          s.style.display = visible ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
