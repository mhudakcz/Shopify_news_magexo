---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import UrgencyBadge from '../../components/UrgencyBadge.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import SourcePill from '../../components/SourcePill.astro';
import Tag from '../../components/Tag.astro';
import { deriveCat, fmtDateCz, SOURCE_LABEL } from '../../lib/article';

export async function getStaticPaths() {
  const all = await getCollection('summaries');
  return all.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const { cat, emoji } = deriveCat(entry.data);

const sortedByDate = [...all].sort(
  (a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const currentIdx = sortedByDate.findIndex((e: any) => e.id === entry.id);
const newer = currentIdx > 0 ? sortedByDate[currentIdx - 1] : null;
const older = currentIdx >= 0 && currentIdx < sortedByDate.length - 1 ? sortedByDate[currentIdx + 1] : null;

const related = (entry.data.souvisejici || [])
  .map((slug: string) => all.find((a: any) => a.data.slug === slug || a.id.replace(/\.md$/, '').endsWith(slug)))
  .filter((x: any) => Boolean(x));

const hasTimeline =
  entry.data.ucinnost_od || entry.data.deprecation_do || entry.data.migrace_doporucena_do;

const sourceHost = entry.data.zdroj_kanal === 'editions' ? "shopify.com / Editions Winter '26"
  : entry.data.zdroj_kanal === 'product-news' ? 'shopify.com / news'
  : entry.data.zdroj_kanal === 'merchant-changelog' ? 'changelog.shopify.com'
  : entry.data.zdroj_kanal === 'blog' ? 'shopify.com / cz / blog'
  : 'shopify.dev / changelog';

let statusBlock: { label: string; cutoff?: string; daysLeft?: number } | null = null;
const now = new Date();
if (entry.data.deprecation_do) {
  const cut = new Date(entry.data.deprecation_do);
  const days = Math.ceil((+cut - +now) / 86400000);
  statusBlock = { label: 'DEPRECATING', cutoff: fmtDateCz(cut), daysLeft: days };
} else if (entry.data.ucinnost_od && new Date(entry.data.ucinnost_od) > now) {
  const eff = new Date(entry.data.ucinnost_od);
  const days = Math.ceil((+eff - +now) / 86400000);
  if (entry.data.kategorie.includes('breaking-change')) {
    statusBlock = { label: 'BREAKING', cutoff: fmtDateCz(eff), daysLeft: days };
  } else if (entry.data.kategorie.includes('nova-api')) {
    statusBlock = { label: 'NEW API', cutoff: fmtDateCz(eff), daysLeft: days };
  } else {
    statusBlock = { label: 'OPPORTUNITY', cutoff: fmtDateCz(eff), daysLeft: days };
  }
}

const yearMonth = `${entry.data.date.getFullYear()}-${String(entry.data.date.getMonth() + 1).padStart(2, '0')}`;
const breadcrumbSlug = entry.id.replace(/\.md$/, '');
---
<Layout title={entry.data.title} variant="detail">
  <div class="breadcrumb">
    <div class="bc-inner">
      <span class="bc-path">news / {yearMonth} / <span class="bc-slug">{breadcrumbSlug}</span></span>
      <span class="bc-meta">id: <span class="bc-mono">{breadcrumbSlug}.md</span></span>
    </div>
  </div>

  <div class="detail-grid">

    <aside class="meta-col">
      <div class="meta-section">
        <div class="eyebrow">Urgency</div>
        <UrgencyBadge level={entry.data.nalehavost} size="lg" />
      </div>

      {statusBlock && (
        <div class={`status-block status-${statusBlock.label.toLowerCase().replace(' ', '-')}`}>
          <div class="status-label">{statusBlock.label}</div>
          <div class="status-cutoff">Cutoff: <span class="mono">{statusBlock.cutoff}</span></div>
          {statusBlock.daysLeft != null && statusBlock.daysLeft > 0 && (
            <div class="status-countdown">{statusBlock.daysLeft} dní · {Math.floor(statusBlock.daysLeft / 7)} týdnů</div>
          )}
        </div>
      )}

      <div class="meta-section">
        <div class="eyebrow">Meta</div>
        <dl class="meta-list">
          <dt>Date</dt><dd class="mono">{entry.data.date.toISOString().slice(0, 10)}</dd>
          <dt>Source</dt><dd>{SOURCE_LABEL[entry.data.zdroj_kanal] || entry.data.zdroj_kanal}</dd>
          {entry.data.api_verze && entry.data.api_verze.length > 0 && (
            <>
              <dt>API verze</dt><dd class="mono">{entry.data.api_verze.join(', ')}</dd>
            </>
          )}
          <dt>Area</dt><dd class="mono">{entry.data.api_oblast}</dd>
          {entry.data.customer_facing && (
            <><dt>Customer-facing</dt><dd>ano</dd></>
          )}
          <dt>Integrátor</dt>
          <dd>
            {entry.data.pouzivame_v_integratoru === 'ano' && <span class="ok">ano</span>}
            {entry.data.pouzivame_v_integratoru === 'mozna' && <span class="warn">možná</span>}
            {entry.data.pouzivame_v_integratoru === 'ne' && <span>ne</span>}
          </dd>
          {entry.data.dotcene_klienty && entry.data.dotcene_klienty.length > 0 && (
            <>
              <dt>Klienti</dt>
              <dd>{entry.data.dotcene_klienty.join(', ')}</dd>
            </>
          )}
        </dl>
      </div>

      {entry.data.tagy && entry.data.tagy.length > 0 && (
        <div class="meta-section">
          <div class="eyebrow">Tags</div>
          <div class="tag-wrap">
            {entry.data.tagy.map((t: string) => <Tag label={t} />)}
          </div>
        </div>
      )}

      <div class="meta-section">
        <a class="back-link" href="/Shopify_news_magexo/">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Zpět na přehled
        </a>
      </div>
    </aside>

    <main class="content-col">
      <div class="content-eyebrow">
        <CategoryIcon cat={cat} emoji={emoji} size={32} />
        <span class="ce-date mono">{entry.data.date.toISOString().slice(0, 10)}</span>
        <span class="ce-sep">·</span>
        <SourcePill src={entry.data.zdroj_kanal} />
        {entry.data.api_verze && entry.data.api_verze.length > 0 && (
          <>
            <span class="ce-sep">·</span>
            <span class="ce-api mono">API {entry.data.api_verze[0]}</span>
          </>
        )}
      </div>

      <h1 class="grad-text">{entry.data.title}</h1>
      {entry.data.title_en && <p class="title-en">{entry.data.title_en}</p>}

      {entry.data.obrazek && (
        <figure class="article-hero">
          <img src={entry.data.obrazek} alt={entry.data.title} loading="lazy" />
        </figure>
      )}

      <div class="tldr">
        <div class="tldr-eyebrow mono">$ TL;DR</div>
        <p>{entry.data.tldr}</p>
      </div>

      {hasTimeline && (
        <aside class="timeline">
          <div class="timeline-eyebrow"><span>⏰</span> Časová osa</div>
          <ul>
            {entry.data.ucinnost_od && (
              <li>
                <span class="dot dot-current"></span>
                <span class="td-date mono">{fmtDateCz(entry.data.ucinnost_od)}</span>
                <span class="td-label">začíná platit</span>
              </li>
            )}
            {entry.data.deprecation_do && (
              <li>
                <span class="dot dot-future"></span>
                <span class="td-date mono">{fmtDateCz(entry.data.deprecation_do)}</span>
                <span class="td-label">končí podpora staré varianty</span>
              </li>
            )}
            {entry.data.migrace_doporucena_do && (
              <li>
                <span class="dot dot-future"></span>
                <span class="td-date mono">{fmtDateCz(entry.data.migrace_doporucena_do)}</span>
                <span class="td-label">doporučený deadline migrace</span>
              </li>
            )}
          </ul>
        </aside>
      )}

      <article class="prose" id="article-body">
        <Content />
      </article>

      {entry.data.dukaz_integratoru && (
        <details class="integrator-detail" open>
          <summary>Integrátor — detail checku</summary>
          <p>{entry.data.dukaz_integratoru}</p>
        </details>
      )}

      {related.length > 0 && (
        <section class="related-section">
          <div class="eyebrow">Související u nás</div>
          <ul class="related-list">
            {related.map((r: any) => (
              <li>
                <a href={`/Shopify_news_magexo/zmena/${r.id.replace(/\.md$/, '')}/`}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="source-footer">
        <span class="sf-icon">🔗</span>
        <a href={entry.data.zdroj} target="_blank" rel="noopener" class="sf-link">
          Originální zpráva
        </a>
        <span class="sf-channel mono">— {sourceHost}</span>
      </div>

      {(newer || older) && (
        <nav class="article-nav" aria-label="Navigace mezi články">
          {older ? (
            <a href={`/Shopify_news_magexo/zmena/${older.id.replace(/\.md$/, '')}/`} class="nav-card prev">
              <span class="dir">← Starší</span>
              <span class="nc-title">{older.data.title}</span>
              <span class="nc-date mono">{fmtDateCz(older.data.date)}</span>
            </a>
          ) : <span class="nav-card-empty" />}
          {newer ? (
            <a href={`/Shopify_news_magexo/zmena/${newer.id.replace(/\.md$/, '')}/`} class="nav-card next">
              <span class="dir">Novější →</span>
              <span class="nc-title">{newer.data.title}</span>
              <span class="nc-date mono">{fmtDateCz(newer.data.date)}</span>
            </a>
          ) : <span class="nav-card-empty" />}
        </nav>
      )}
    </main>

    <aside class="toc-col">
      <div class="eyebrow">Na této stránce</div>
      <nav class="toc" id="toc"></nav>
    </aside>
  </div>

  <script>
    const body = document.getElementById('article-body');
    const toc = document.getElementById('toc');
    if (body && toc) {
      const headings = body.querySelectorAll('h2, h3');
      headings.forEach((h) => {
        if (!h.id) {
          h.id = (h.textContent || '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '');
        }
        const link = document.createElement('a');
        link.href = `#${h.id}`;
        link.textContent = h.textContent || '';
        link.className = h.tagName === 'H3' ? 'toc-link toc-sub' : 'toc-link';
        toc.appendChild(link);
      });

      const links = toc.querySelectorAll('a');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            const link = toc.querySelector(`a[href="#${id}"]`);
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              link?.classList.add('active');
            }
          });
        },
        { rootMargin: '-30% 0px -65% 0px' }
      );
      headings.forEach((h) => observer.observe(h));
    }
  </script>
</Layout>

<style>
  .breadcrumb {
    padding: 12px 32px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border-1);
    font-size: 12px;
    font-family: var(--font-mono);
  }
  .bc-inner { display: flex; justify-content: space-between; max-width: 1400px; margin: 0 auto; }
  .bc-path { color: var(--fg-3); }
  .bc-slug { color: var(--fg-1); }
  .bc-meta { color: var(--fg-3); }
  .bc-mono { color: var(--fg-2); }

  .detail-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 240px;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 600px;
  }

  .meta-col {
    border-right: 1px solid var(--border-1);
    padding: 32px 24px;
    font-size: 13px;
    font-family: var(--font-sans);
  }
  .meta-section { margin-bottom: 28px; }
  .eyebrow {
    font-size: 10px;
    font-weight: 700;
    color: var(--fg-4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 10px;
  }

  .status-block {
    padding: 14px;
    border-radius: 10px;
    border: 1px solid var(--urg-high-border);
    background: var(--urg-high-bg);
    color: var(--urg-high-fg);
    font-family: var(--font-mono);
    margin-bottom: 28px;
  }
  .status-block.status-deprecating, .status-block.status-breaking {
    border-color: var(--urg-critical-border);
    background: var(--urg-critical-bg);
    color: var(--urg-critical-fg);
  }
  .status-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 6px; }
  .status-cutoff { font-size: 12px; margin-bottom: 4px; }
  .status-countdown { font-size: 11px; opacity: 0.8; }

  .meta-list { display: grid; grid-template-columns: 100px 1fr; gap: 6px 12px; margin: 0; font-family: var(--font-mono); font-size: 12px; }
  .meta-list dt { color: var(--fg-3); font-weight: 500; }
  .meta-list dd { margin: 0; color: var(--fg-1); text-align: right; }
  .mono { font-family: var(--font-mono); }
  .meta-list dd .ok { color: var(--emerald-600); font-weight: 600; }
  [data-theme="dark"] .meta-list dd .ok { color: var(--emerald-500); }
  .meta-list dd .warn { color: var(--orange); font-weight: 600; }
  .tag-wrap { display: flex; flex-wrap: wrap; gap: 6px; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--indigo-600);
    font-size: 13px;
    font-weight: 500;
  }
  [data-theme="dark"] .back-link { color: var(--indigo-300); }

  .content-col {
    padding: 32px 40px 64px;
    min-width: 0;
  }
  .content-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 12px;
    flex-wrap: wrap;
  }
  .ce-date, .ce-api { color: var(--fg-3); font-family: var(--font-mono); font-size: 12px; }
  .ce-sep { color: var(--fg-4); }

  .content-col h1 {
    margin: 0;
    font-size: 38px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .title-en {
    color: var(--fg-3);
    font-style: italic;
    font-size: 14px;
    margin: 6px 0 0;
  }

  .article-hero {
    margin: 24px 0 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-1);
  }
  .article-hero img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
  }

  .tldr {
    margin: 24px 0;
    background: var(--bg-2);
    border-top: 3px solid var(--indigo-600);
    border-radius: 0 0 10px 10px;
    padding: 14px 18px 16px;
  }
  .tldr-eyebrow {
    font-size: 11px;
    color: var(--indigo-700);
    margin-bottom: 6px;
    font-weight: 600;
  }
  [data-theme="dark"] .tldr-eyebrow { color: var(--indigo-300); }
  .tldr p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--fg-1); }

  .timeline {
    margin: 24px 0;
    padding: 18px 22px;
    background: var(--urg-high-bg);
    border: 1px solid var(--urg-high-border);
    border-left: 3px solid var(--orange);
    border-radius: 10px;
  }
  .timeline-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--urg-high-fg);
    font-weight: 700;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .timeline ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .timeline li {
    display: grid;
    grid-template-columns: 16px 130px 1fr;
    gap: 12px;
    align-items: center;
    font-size: 13px;
  }
  .timeline .dot { width: 10px; height: 10px; border-radius: 5px; justify-self: center; }
  .timeline .dot-current { background: var(--orange); box-shadow: 0 0 0 3px rgba(255, 103, 0, 0.18); width: 12px; height: 12px; }
  .timeline .dot-future { background: transparent; border: 2px solid var(--fg-4); }
  .timeline .td-date { color: var(--fg-1); font-size: 12px; }
  .timeline .td-label { color: var(--fg-2); }

  .prose {
    margin-top: 32px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg-2);
    max-width: 720px;
  }
  .prose :global(h2) {
    margin: 36px 0 12px;
    font-size: 22px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--fg-1);
    text-wrap: balance;
  }
  .prose :global(h3) {
    margin: 24px 0 8px;
    font-size: 16px;
    font-weight: 700;
    color: var(--fg-1);
    font-family: var(--font-sans);
    letter-spacing: -0.015em;
  }
  .prose :global(p) { margin: 0 0 14px; text-wrap: pretty; }
  .prose :global(strong) { color: var(--fg-1); font-weight: 600; }
  .prose :global(em) { font-style: italic; color: var(--fg-2); }
  .prose :global(a) {
    color: var(--indigo-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--indigo-300);
  }
  [data-theme="dark"] .prose :global(a) { color: var(--indigo-300); text-decoration-color: var(--indigo-500); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 14px; padding-left: 1.4em; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(code) {
    background: var(--bg-3);
    border: 1px solid var(--border-1);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .prose :global(pre) {
    background: var(--bg-3);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    margin: 16px 0;
  }
  .prose :global(pre code) { background: transparent; border: none; padding: 0; }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
    font-size: 13px;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border-1);
    padding: 8px 12px;
    text-align: left;
  }
  .prose :global(th) { background: var(--bg-2); font-weight: 600; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--indigo-600);
    padding: 4px 0 4px 16px;
    margin: 16px 0;
    color: var(--fg-2);
    font-style: italic;
  }

  .integrator-detail {
    margin: 24px 0;
    padding: 14px 18px;
    border: 1px solid var(--border-1);
    border-radius: 10px;
    background: var(--bg-2);
    font-size: 13px;
    color: var(--fg-2);
  }
  .integrator-detail summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fg-1);
    margin-bottom: 6px;
    font-family: var(--font-mono);
  }
  .integrator-detail p { margin: 8px 0 0; }

  .related-section { margin: 32px 0; }
  .related-list { list-style: none; padding: 0; margin: 8px 0 0; }
  .related-list li { padding: 8px 0; border-bottom: 1px solid var(--border-1); }
  .related-list a { color: var(--indigo-600); font-size: 14px; }
  [data-theme="dark"] .related-list a { color: var(--indigo-300); }

  .source-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    margin: 32px 0 0;
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: 10px;
    font-size: 13px;
  }
  .sf-link {
    color: var(--indigo-600);
    font-weight: 600;
  }
  [data-theme="dark"] .sf-link { color: var(--indigo-300); }
  .sf-channel { color: var(--fg-3); font-family: var(--font-mono); font-size: 12px; }

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 32px;
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: var(--bg-elev);
    border: 1px solid var(--border-1);
    border-radius: 10px;
    transition: all 0.15s;
    box-shadow: var(--shadow-xs);
    color: var(--fg-1);
    text-decoration: none;
  }
  .nav-card:hover {
    border-color: var(--border-2);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .nav-card.next { text-align: right; align-items: flex-end; }
  .nav-card .dir { font-size: 11px; font-weight: 700; color: var(--indigo-600); text-transform: uppercase; letter-spacing: 0.06em; }
  [data-theme="dark"] .nav-card .dir { color: var(--indigo-300); }
  .nav-card .nc-title {
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nav-card .nc-date { font-size: 11px; color: var(--fg-3); }
  .nav-card-empty { display: block; }

  .toc-col {
    border-left: 1px solid var(--border-1);
    padding: 32px 20px;
    position: sticky;
    top: 60px;
    align-self: start;
    height: max-content;
  }
  .toc { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
  .toc :global(a.toc-link) {
