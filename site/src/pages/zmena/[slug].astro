---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DetailSidebar from '../../components/DetailSidebar.astro';
import UrgencyBadge from '../../components/UrgencyBadge.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import SourcePill from '../../components/SourcePill.astro';
import Tag from '../../components/Tag.astro';
import { deriveCat, fmtDateCz, SOURCE_LABEL } from '../../lib/article';

export async function getStaticPaths() {
  const all = await getCollection('summaries');
  const counts = {
    all: all.length,
    'breaking-change': all.filter((i: any) => i.data.kategorie.includes('breaking-change')).length,
    'nova-prilezitost': all.filter((i: any) => i.data.kategorie.some((k: string) => k === 'nova-prilezitost' || k === 'nova-api')).length,
    deprecation: all.filter((i: any) => i.data.kategorie.includes('deprecation')).length,
    uses: all.filter((i: any) => i.data.pouzivame_v_integratoru === 'ano').length,
    customer: all.filter((i: any) => i.data.customer_facing).length,
    urgent: all.filter((i: any) => ['kriticka', 'vysoka'].includes(i.data.nalehavost)).length,
    dev: all.filter((i: any) => i.data.zdroj_kanal === 'dev-changelog').length,
    merchant: all.filter((i: any) => i.data.zdroj_kanal === 'merchant-changelog').length,
    editions: all.filter((i: any) => i.data.zdroj_kanal === 'editions').length,
    blog: all.filter((i: any) => i.data.zdroj_kanal === 'blog').length,
    news: all.filter((i: any) => i.data.zdroj_kanal === 'product-news').length,
  };
  return all.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, all, counts },
  }));
}

const { entry, all, counts } = Astro.props;
const { Content } = await render(entry);
const { cat, emoji } = deriveCat(entry.data);

const sortedByDate = [...all].sort(
  (a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const currentIdx = sortedByDate.findIndex((e: any) => e.id === entry.id);
const newer = currentIdx > 0 ? sortedByDate[currentIdx - 1] : null;
const older = currentIdx >= 0 && currentIdx < sortedByDate.length - 1 ? sortedByDate[currentIdx + 1] : null;

const related = (entry.data.souvisejici || [])
  .map((slug: string) => all.find((a: any) => a.data.slug === slug || a.id.replace(/\.md$/, '').endsWith(slug)))
  .filter((x: any) => Boolean(x));

const hasTimeline =
  entry.data.ucinnost_od || entry.data.deprecation_do || entry.data.migrace_doporucena_do;

const sourceHost = entry.data.zdroj_kanal === 'editions' ? "shopify.com / Editions Winter '26"
  : entry.data.zdroj_kanal === 'product-news' ? 'shopify.com / news'
  : entry.data.zdroj_kanal === 'merchant-changelog' ? 'changelog.shopify.com'
  : entry.data.zdroj_kanal === 'blog' ? 'shopify.com / cz / blog'
  : 'shopify.dev / changelog';

let statusBlock: { label: string; cutoff?: string; daysLeft?: number } | null = null;
const now = new Date();
if (entry.data.deprecation_do) {
  const cut = new Date(entry.data.deprecation_do);
  const days = Math.ceil((+cut - +now) / 86400000);
  statusBlock = { label: 'DEPRECATING', cutoff: fmtDateCz(cut), daysLeft: days };
} else if (entry.data.ucinnost_od && new Date(entry.data.ucinnost_od) > now) {
  const eff = new Date(entry.data.ucinnost_od);
  const days = Math.ceil((+eff - +now) / 86400000);
  if (entry.data.kategorie.includes('breaking-change')) {
    statusBlock = { label: 'BREAKING', cutoff: fmtDateCz(eff), daysLeft: days };
  } else if (entry.data.kategorie.includes('nova-api')) {
    statusBlock = { label: 'NEW API', cutoff: fmtDateCz(eff), daysLeft: days };
  } else {
    statusBlock = { label: 'OPPORTUNITY', cutoff: fmtDateCz(eff), daysLeft: days };
  }
}

const yearMonth = `${entry.data.date.getFullYear()}-${String(entry.data.date.getMonth() + 1).padStart(2, '0')}`;
const breadcrumbSlug = entry.id.replace(/\.md$/, '');
const hasImage = !!entry.data.obrazek;
---
<Layout title={entry.data.title} variant="detail" noHeader={true}>
  <div class="app-grid">
    <DetailSidebar entry={entry} counts={counts} />

    <main class="detail-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <div class="breadcrumb-inner">
          <a href="/Shopify_news_magexo/" class="bc-home">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
            Shopify novinky
          </a>
          <span class="bc-sep">›</span>
          <span class="bc-current">{entry.data.title}</span>
        </div>
      </nav>

      <article class="article">
        <div class="article-eyebrow">
          <CategoryIcon cat={cat} emoji={emoji} size={32} />
          <SourcePill src={entry.data.zdroj_kanal} />
          <span class="flag">{entry.data.title_en ? 'GB' : 'CZ'}</span>
          <span class="bullet">·</span>
          <span class="date mono">{entry.data.date.toISOString().slice(0, 10)}</span>
          {entry.data.api_verze && entry.data.api_verze.length > 0 && (
            <>
              <span class="bullet">·</span>
              <span class="api-ver mono">API {entry.data.api_verze[0]}</span>
            </>
          )}
        </div>

        <h1 class="grad-text article-title">{entry.data.title}</h1>
        {entry.data.title_en && <p class="title-en">{entry.data.title_en}</p>}

        {hasImage && (
          <figure class="article-hero">
            <img src={entry.data.obrazek} alt={entry.data.title} loading="lazy" />
          </figure>
        )}

        <div class="tldr">
          <div class="tldr-eyebrow mono">$ TL;DR</div>
          <p>{entry.data.tldr}</p>
        </div>

        {hasTimeline && (
          <aside class="timeline">
            <div class="timeline-eyebrow"><span>⏰</span> Časová osa</div>
            <ul>
              {entry.data.ucinnost_od && (
                <li>
                  <span class="dot dot-current"></span>
                  <span class="td-date mono">{fmtDateCz(entry.data.ucinnost_od)}</span>
                  <span class="td-label">začíná platit</span>
                </li>
              )}
              {entry.data.deprecation_do && (
                <li>
                  <span class="dot dot-future"></span>
                  <span class="td-date mono">{fmtDateCz(entry.data.deprecation_do)}</span>
                  <span class="td-label">končí podpora staré varianty</span>
                </li>
              )}
              {entry.data.migrace_doporucena_do && (
                <li>
                  <span class="dot dot-future"></span>
                  <span class="td-date mono">{fmtDateCz(entry.data.migrace_doporucena_do)}</span>
                  <span class="td-label">doporučený deadline migrace</span>
                </li>
              )}
            </ul>
          </aside>
        )}

        <div class="prose" id="article-body">
          <Content />
        </div>

        {entry.data.kontext && (
          <section class="kontext" aria-label="Doplňující kontext">
            <header class="kontext-head">
              <span class="kontext-eyebrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
                Doplňující kontext
              </span>
              <span class="kontext-badge" title={`Generováno modelem ${entry.data.kontext.model} dne ${entry.data.kontext.generated_at.toISOString().slice(0, 10)}`}>AI</span>
            </header>
            <div class="kontext-body">
              {entry.data.kontext.background
                .split(/\n{2,}/)
                .map((para: string) => para.trim())
                .filter((para: string) => para.length > 0)
                .map((para: string) => <p>{para}</p>)}
              {entry.data.kontext.priklad && (
                <pre class="kontext-priklad"><code>{entry.data.kontext.priklad}</code></pre>
              )}
            </div>
            <footer class="kontext-sources">
              <span class="ks-label">Zdroje:</span>
              <ul>
                {entry.data.kontext.zdroje.map((src: { title: string; url: string }) => {
                  let host = '';
                  try { host = new URL(src.url).hostname.replace(/^www\./, ''); } catch {}
                  return (
                    <li>
                      <a href={src.url} target="_blank" rel="noopener">
                        {src.title}
                        <span class="ks-host mono">{host}</span>
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </footer>
          </section>
        )}

        {entry.data.dukaz_integratoru && (
          <details class="integrator-detail" open>
            <summary>Integrátor — detail checku</summary>
            <p>{entry.data.dukaz_integratoru}</p>
          </details>
        )}

        {entry.data.dotcene_klienty && entry.data.dotcene_klienty.length > 0 && (
          <section class="affected">
            <h3>Dotčení klienti</h3>
            <ul>{entry.data.dotcene_klienty.map((k: string) => <li>{k}</li>)}</ul>
          </section>
        )}

        {related.length > 0 && (
          <section class="related-section">
            <h3>Související u nás</h3>
            <ul class="related-list">
              {related.map((r: any) => (
                <li>
                  <a href={`/Shopify_news_magexo/zmena/${r.id.replace(/\.md$/, '')}/`}>{r.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="source-footer">
          <span class="sf-icon">🔗</span>
          <a href={entry.data.zdroj} target="_blank" rel="noopener" class="sf-link">
            Originální zpráva
          </a>
          <span class="sf-channel mono">— {sourceHost}</span>
        </div>

        {(newer || older) && (
          <nav class="article-nav" aria-label="Navigace mezi články">
            {newer ? (
              <a href={`/Shopify_news_magexo/zmena/${newer.id.replace(/\.md$/, '')}/`} class="nav-card prev">
                <span class="dir">← Novější</span>
                <span class="nc-title">{newer.data.title}</span>
                <span class="nc-date mono">{fmtDateCz(newer.data.date)}</span>
              </a>
            ) : <span class="nav-card-empty" />}
            {older ? (
              <a href={`/Shopify_news_magexo/zmena/${older.id.replace(/\.md$/, '')}/`} class="nav-card next">
                <span class="dir">Starší →</span>
                <span class="nc-title">{older.data.title}</span>
                <span class="nc-date mono">{fmtDateCz(older.data.date)}</span>
              </a>
            ) : <span class="nav-card-empty" />}
          </nav>
        )}
      </article>
    </main>
  </div>

  <script>
    const body = document.getElementById('article-body');
    const toc = document.getElementById('toc');
    if (body && toc) {
      const headings = body.querySelectorAll('h2, h3');
      headings.forEach((h) => {
        if (!h.id) {
          h.id = (h.textContent || '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '');
        }
        const link = document.createElement('a');
        link.href = `#${h.id}`;
        link.textContent = h.textContent || '';
        link.className = h.tagName === 'H3' ? 'toc-link toc-sub' : 'toc-link';
        toc.appendChild(link);
      });

      const links = toc.querySelectorAll('a');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            const link = toc.querySelector(`a[href="#${id}"]`);
            if (entry.isIntersecting) {
              links.forEach((l) => l.classList.remove('active'));
              link?.classList.add('active');
            }
          });
        },
        { rootMargin: '-30% 0px -65% 0px' }
      );
      headings.forEach((h) => observer.observe(h));
    }
  </script>
</Layout>

<style>
  .app-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
  }

  .detail-main {
    min-width: 0;
    position: relative;
  }

  /* Breadcrumb */
  .breadcrumb {
    border-bottom: 1px solid var(--border-1);
    background: var(--bg-2);
  }
  .breadcrumb-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 820px;
    margin: 0;
    padding: 14px 48px;
    font-size: 13px;
    overflow: hidden;
  }
  .bc-home {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--indigo-600);
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
  }
  .bc-home:hover { color: var(--indigo-700); text-decoration: none; }
  :global([data-theme="dark"]) .bc-home { color: var(--indigo-300); }
  .bc-sep { color: var(--fg-4); flex-shrink: 0; }
  .bc-current {
    color: var(--fg-2);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* Article container — clean reading layout, left-aligned */
  .article {
    max-width: 820px;
    margin: 0;
    padding: 48px 48px 64px;
    position: relative;
  }

  .article-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    font-size: 12px;
  }
  .article-eyebrow .flag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--fg-4);
    border: 1px solid var(--border-2);
    border-radius: 3px;
    padding: 1px 4px;
    line-height: 1.3;
  }
  .article-eyebrow .bullet { color: var(--fg-4); }
  .article-eyebrow .date, .article-eyebrow .api-ver { color: var(--fg-3); font-family: var(--font-mono); }

  .article-title {
    font-size: clamp(32px, 4.5vw, 48px);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 8px;
    text-wrap: balance;
  }
  .title-en {
    color: var(--fg-3);
    font-style: italic;
    font-size: 16px;
    margin: 0 0 24px;
  }

  /* Meta strip — horizontal pills */
  .article-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-bottom: 24px;
  }
  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px 3px 6px;
    background: var(--bg-3);
    color: var(--fg-2);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
  }
  .meta-pill.ok { background: var(--cat-uses-bg); color: var(--cat-uses-fg); }
  .meta-pill.warn { background: var(--cat-deprecation-bg); color: var(--cat-deprecation-fg); }

  /* Status banner */
  .status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 10px;
    border: 1px solid var(--urg-high-border);
    background: var(--urg-high-bg);
    color: var(--urg-high-fg);
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .status-banner.status-deprecating, .status-banner.status-breaking {
    border-color: var(--urg-critical-border);
    background: var(--urg-critical-bg);
    color: var(--urg-critical-fg);
  }
  .status-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; }
  .status-info { display: flex; gap: 8px; align-items: center; }
  .status-info strong { font-weight: 700; }
  .status-countdown { opacity: 0.85; font-size: 12px; }

  /* Hero image */
  .article-hero {
    margin: 24px -16px 32px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-1);
  }
  .article-hero img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
  }

  /* TL;DR */
  .tldr {
    margin: 0 0 24px;
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-left: 4px solid var(--indigo-600);
    border-radius: 4px 10px 10px 4px;
    padding: 14px 18px 16px;
  }
  .tldr-eyebrow {
    font-size: 11px;
    color: var(--indigo-700);
    margin-bottom: 6px;
    font-weight: 600;
  }
  :global([data-theme="dark"]) .tldr-eyebrow { color: var(--indigo-300); }
  .tldr p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--fg-1); }

  /* Timeline */
  .timeline {
    margin: 0 0 24px;
    padding: 16px 18px;
    background: var(--urg-high-bg);
    border: 1px solid var(--urg-high-border);
    border-left: 3px solid var(--orange);
    border-radius: 10px;
  }
  .timeline-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--urg-high-fg);
    font-weight: 700;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .timeline ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .timeline li {
    display: grid;
    grid-template-columns: 16px 130px 1fr;
    gap: 12px;
    align-items: center;
    font-size: 13px;
  }
  .timeline .dot { width: 10px; height: 10px; border-radius: 5px; justify-self: center; }
  .timeline .dot-current { background: var(--orange); box-shadow: 0 0 0 3px rgba(255, 103, 0, 0.18); width: 12px; height: 12px; }
  .timeline .dot-future { background: transparent; border: 2px solid var(--fg-4); }
  .timeline .td-date { color: var(--fg-1); font-size: 12px; }
  .timeline .td-label { color: var(--fg-2); }

  /* Prose body */
  .prose {
    margin-top: 32px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-1);
  }
  .prose :global(h2) {
    margin: 40px 0 14px;
    font-size: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--fg-1);
    text-wrap: balance;
    scroll-margin-top: 80px;
  }
  .prose :global(h3) {
    margin: 28px 0 10px;
    font-size: 17px;
    font-weight: 700;
    color: var(--fg-1);
    font-family: var(--font-sans);
    letter-spacing: -0.015em;
    scroll-margin-top: 80px;
  }
  .prose :global(p) { margin: 0 0 16px; text-wrap: pretty; color: var(--fg-2); }
  .prose :global(strong) { color: var(--fg-1); font-weight: 600; }
  .prose :global(em) { font-style: italic; color: var(--fg-2); }
  .prose :global(a) {
    color: var(--indigo-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--indigo-300);
  }
  :global([data-theme="dark"]) .prose :global(a) { color: var(--indigo-300); text-decoration-color: var(--indigo-500); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 1.4em; color: var(--fg-2); }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(code) {
    background: var(--bg-3);
    border: 1px solid var(--border-1);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .prose :global(pre) {
    background: var(--bg-3);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    margin: 16px 0;
  }
  .prose :global(pre code) { background: transparent; border: none; padding: 0; }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
    font-size: 14px;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border-1);
    padding: 8px 12px;
    text-align: left;
  }
  .prose :global(th) { background: var(--bg-2); font-weight: 600; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--indigo-600);
    padding: 4px 0 4px 16px;
    margin: 16px 0;
    color: var(--fg-2);
    font-style: italic;
  }

  /* Kontext (AI-doplněno) */
  .kontext {
    margin: 32px 0 28px;
    padding: 20px 22px 18px;
    border: 1px solid var(--border-1);
    border-left: 3px solid var(--indigo-600);
    border-radius: 10px;
    background: linear-gradient(180deg, var(--indigo-50) 0%, var(--bg-elev) 60%);
  }
  :global([data-theme="dark"]) .kontext {
    background: linear-gradient(180deg, rgba(79, 70, 229, 0.08) 0%, var(--bg-elev) 60%);
  }
  .kontext-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .kontext-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--indigo-700);
  }
  :global([data-theme="dark"]) .kontext-eyebrow { color: var(--indigo-300); }
  .kontext-eyebrow svg { color: currentColor; }
  .kontext-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    background: var(--indigo-600);
    color: #fff;
    border-radius: 4px;
    cursor: help;
  }
  .kontext-body {
    font-family: var(--font-serif);
    font-size: 17px;
